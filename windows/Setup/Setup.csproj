    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ShuangpinLinkSetup</AssemblyName>
    <ApplicationIcon>../Link/ShuangpinLink.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/InputPaths.cs" Link="InputPaths.cs" />
